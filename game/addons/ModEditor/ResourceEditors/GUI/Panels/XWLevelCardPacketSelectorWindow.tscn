[gd_scene format=3]

[node name="CardPacketSelectorWindow" type="Window"]
title = "选择卡牌"
initial_position = 1
size = Vector2i(860, 620)
min_size = Vector2i(720, 480)
transient = true

[node name="Layout" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="Filter" type="LineEdit" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "过滤 saveKey、来源或路径"

[node name="PacketScroll" type="ScrollContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PacketGrid" type="GridContainer" parent="Layout/PacketScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 1

[node name="Description" type="Label" parent="Layout"]
custom_minimum_size = Vector2(640, 46)
layout_mode = 2
size_flags_horizontal = 3
text = "没有选择卡牌"
autowrap_mode = 2

[node name="Controls" type="HBoxContainer" parent="Layout"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6
alignment = 2

[node name="CancelButton" type="Button" parent="Layout/Controls"]
layout_mode = 2
text = "取消"

[node name="SelectButton" type="Button" parent="Layout/Controls"]
layout_mode = 2
text = "选择"
