[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://addons/ModEditor/ResourceEditors/GUI/Panels/XWNpcTalkPreviewWindow.cs" id="1_script"]
[ext_resource type="PackedScene" path="res://Asset/Config/Map/Frontlawn/Scene/Day/TowerDefenseMapFrontlawn.tscn" id="2_game_map"]
[ext_resource type="PackedScene" path="res://Registry/Battle/Feature/NpcTalk/Control/NpcTalkControl.tscn" id="3_runtime_control"]
[ext_resource type="Script" path="res://addons/ModEditor/ResourceEditors/GUI/Panels/XWAspectScaledPreviewHost.cs" id="4_scaled_host"]

[node name="NpcTalkRuntimePreviewWindow" type="Window"]
title = "NPC 对话运行预览"
initial_position = 1
size = Vector2i(1200, 760)
min_size = Vector2i(640, 420)
transient = true
script = ExtResource("1_script")

[node name="Layout" type="VBoxContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

[node name="Header" type="HFlowContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "NPC 对话运行预览"

[node name="Hint" type="Label" parent="Layout/Header"]
layout_mode = 2
text = "空格 / → 下一句    ← 上一句    Esc 关闭"

[node name="GameCanvasCenter" type="Control" parent="Layout"]
unique_name_in_owner = true
custom_minimum_size = Vector2(540, 300)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
clip_contents = true
script = ExtResource("4_scaled_host")

[node name="ViewportContainer" type="SubViewportContainer" parent="Layout/GameCanvasCenter"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 520)
layout_mode = 0
offset_right = 1080.0
offset_bottom = 600.0
mouse_filter = 0

[node name="Viewport" type="SubViewport" parent="Layout/GameCanvasCenter/ViewportContainer"]
size = Vector2i(1080, 600)
render_target_update_mode = 4
handle_input_locally = true

[node name="GameMap" parent="Layout/GameCanvasCenter/ViewportContainer/Viewport" instance=ExtResource("2_game_map")]

[node name="NpcUiLayer" type="CanvasLayer" parent="Layout/GameCanvasCenter/ViewportContainer/Viewport"]
layer = 4
follow_viewport_enabled = false

[node name="RuntimeNpcTalkControl" parent="Layout/GameCanvasCenter/ViewportContainer/Viewport/NpcUiLayer" instance=ExtResource("3_runtime_control")]
unique_name_in_owner = true

[node name="EmptyLabel" type="Label" parent="Layout/GameCanvasCenter/ViewportContainer/Viewport"]
offset_left = 320.0
offset_top = 270.0
offset_right = 760.0
offset_bottom = 330.0
text = "当前对话没有可预览的条目"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Controls" type="HFlowContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="PreviousButton" type="Button" parent="Layout/Controls"]
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
text = "◀ 上一句"

[node name="ReplayButton" type="Button" parent="Layout/Controls"]
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
text = "重播当前"

[node name="AutoButton" type="Button" parent="Layout/Controls"]
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
text = "播放整段"

[node name="NextButton" type="Button" parent="Layout/Controls"]
custom_minimum_size = Vector2(110, 36)
layout_mode = 2
text = "下一句 ▶"

[node name="Status" type="Label" parent="Layout"]
layout_mode = 2
text = "0 / 0"
horizontal_alignment = 1
autowrap_mode = 2

[node name="AutoTimer" type="Timer" parent="."]
wait_time = 3.2
one_shot = true

[node name="DirectAudioPlayer" type="AudioStreamPlayer" parent="."]
bus = &"SFX"
