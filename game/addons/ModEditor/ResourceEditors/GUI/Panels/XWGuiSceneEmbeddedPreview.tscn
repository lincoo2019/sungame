[gd_scene format=3]

[node name="GuiSceneEmbeddedPreview" type="PanelContainer"]
custom_minimum_size = Vector2(0, 480)
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Title" type="Label" parent="Layout"]
layout_mode = 2
text = "GUI 预览"

[node name="ViewportContainer" type="SubViewportContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
stretch = true

[node name="Viewport" type="SubViewport" parent="Layout/ViewportContainer"]
size = Vector2i(1080, 600)
transparent_bg = true
render_target_update_mode = 4
handle_input_locally = true

[node name="PreviewRoot" type="Control" parent="Layout/ViewportContainer/Viewport"]
unique_name_in_owner = true
offset_right = 1080.0
offset_bottom = 600.0
mouse_filter = 2

[node name="ErrorLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 2
