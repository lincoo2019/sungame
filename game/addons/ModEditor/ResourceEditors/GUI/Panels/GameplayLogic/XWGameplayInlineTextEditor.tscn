[gd_scene format=3]

[node name="InlineTextEditor" type="PanelContainer"]
unique_name_in_owner = true
custom_minimum_size = Vector2(360, 108)

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 6

[node name="SpeakerLabel" type="Label" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
text = "游戏文本"

[node name="BubblePanel" type="PanelContainer" parent="Layout"]
layout_mode = 2

[node name="InlineLineEdit" type="LineEdit" parent="Layout/BubblePanel"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "直接在游戏气泡中编辑文本..."
select_all_on_focus = true

[node name="Actions" type="HBoxContainer" parent="Layout"]
layout_mode = 2
alignment = 2

[node name="CancelButton" type="Button" parent="Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "取消"

[node name="ConfirmButton" type="Button" parent="Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "应用"
