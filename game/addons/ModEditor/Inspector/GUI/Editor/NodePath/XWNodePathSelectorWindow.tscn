[node name="NodePathSelectorTree" type="Tree" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/icon_max_width = 32

[node name="NodePathPreviewLabel" type="Label" parent="Margin/Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
