[node name="Buttons" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2
size_flags_horizontal = 3
alignment = 2

[node name="ClearNodePath" type="Button" parent="Margin/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
