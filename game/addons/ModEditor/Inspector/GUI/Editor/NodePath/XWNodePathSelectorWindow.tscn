[node name="Spacer" type="Control" parent="Margin/Layout/Buttons"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CancelNodePathSelection" type="Button" parent="Margin/Layout/Buttons"]
unique_name_in_owner = true
layout_mode = 2
