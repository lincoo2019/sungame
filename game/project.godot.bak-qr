; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_custom_features="dotnet"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="植物大战僵尸杂交版"
config/version="0.29.0.0"
run/main_scene="uid://3q5h8vq3vco5"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/flush_stdout_on_print=true
run/max_fps=30
boot_splash/show_image=false
config/icon="uid://crb2yf8xsx013"

[audio]

driver/output_latency=30
buses/channel_disable_threshold_db=-40.0

[autoload]

Global="res://Core/Global/Global.tscn"
GameSaveManager="res://Core/GameSaveManager/GameSaveManager.tscn"
GlobalFeatureManager="res://Core/GlobalFeatureManager/GlobalFeatureManager.tscn"
BattleEventBus="res://Core/BattleEventBus/BattleEventBus.tscn"
MultiPlayerManager="res://Core/MultiPlayerManager/MultiPlayerManager.tscn"
InternetServerManager="res://Core/InternetServerManager/InternetServerManager.tscn"
SceneManager="res://Core/SceneManager/SceneManager.tscn"
AudioManager="res://Core/AudioManager/AudioManager.tscn"
ObjectManager="res://Core/ObjectManager/ObjectManager.tscn"
DialogManager="res://Core/DialogManager/DialogManager.tscn"
BroadCastManager="res://Core/BroadCastManager/BroadCastManager.tscn"
ResourceManager="res://Core/ResourceManager/ResourceManager.tscn"
ViewManager="res://Core/ViewManager/ViewManager.tscn"
TutorialManager="res://Core/TutorialManager/TutorialManager.tscn"
TowerDefenseManager="res://Core/TowerDefenseManager/TowerDefenseManager.tscn"
CommandManager="res://Core/CommandManager/CommandManager.tscn"
CrashLogger="res://Core/CrashLogger/CrashLogger.tscn"
CommandConsole="res://Core/CommandConsole/CommandConsole.tscn"
Cursor="*res://addons/awesome_custom_cursor/Autoloads/Cursor.tscn"
ModEditorManager="res://addons/ModEditor/Core/ModEditorManager.tscn"

[debug]

file_logging/enable_file_logging=true
settings/gdscript/max_call_stack=2047

[display]

window/size/viewport_width=1080
window/size/viewport_height=600
window/size/window_width_override=1620
window/size/window_height_override=900
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=4
window/vsync/vsync_mode=0
window/vsync/vsync_mode.android=1

[dotnet]

project/assembly_name="PlantsVsZombies"

[editor]

naming/script_name_casing=1
import/atlas_max_width=5000
export/convert_text_resources_to_binary=false

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/AdobeAnimateEditor/plugin.cfg", "res://addons/awesome_custom_cursor/plugin.cfg", "res://addons/godot_state_charts/plugin.cfg")

