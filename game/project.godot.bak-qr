[input_devices]

pen_tablet/driver.windows="dummy"

[internationalization]

locale/translations=PackedStringArray("res://Asset/Translate/Translate.en.translation", "res://Asset/Translate/Translate.es.translation", "res://Asset/Translate/Translate.zh.translation")

[layer_names]

2d_physics/layer_1="Character"
2d_physics/layer_2="Projectile"
2d_physics/layer_4="Fog"

[physics]

2d/run_on_separate_thread=true
2d/solver/solver_iterations=1
common/enable_object_picking=false

[rendering]

rendering_device/d3d12/max_sampler_descriptors=2048
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
2d/shadow_atlas/size=128
gl_compatibility/item_buffer_size=65536
shading/overrides/force_vertex_shading=true
environment/ssao/quality=0
environment/ssil/quality=0
anti_aliasing/screen_space_roughness_limiter/enabled=false
environment/glow/upscale_mode=0
environment/volumetric_fog/use_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
